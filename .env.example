# Used by docker-compose.yml to configure the db, backend and frontend
# containers together. Copy this file to .env (never commit the real one)
# before running `docker compose up`.

# --- Database ---
POSTGRES_USER=axis
POSTGRES_PASSWORD=change-this-postgres-password
POSTGRES_DB=axis

# --- Backend ---
# Long random string, e.g. `openssl rand -hex 32`.
JWT_SECRET=change-this-to-a-long-random-string
# The public URL the site is served at (browser-facing origin). Locally this
# is where the frontend container publishes to; in production it's your domain.
CORS_ORIGIN=http://localhost:8080

# First Admin account, created once by the backend container's entrypoint.
# No other accounts or sample applications are ever seeded.
SEED_ADMIN_EMAIL=admin@aircairo.com
SEED_ADMIN_PASSWORD=change-this-admin-password
SEED_ADMIN_NAME=System Administrator

# --- Frontend ---
# Host port the site is published on (maps to nginx's container port 80).
HTTP_PORT=8080
