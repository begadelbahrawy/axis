# PostgreSQL connection string
DATABASE_URL="postgresql://axis:axis@localhost:5432/axis?schema=public"

# HTTP
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Auth
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=12h
JWT_REMEMBER_EXPIRES_IN=30d

# File storage (local disk). Point this at a mounted volume in production,
# or swap middleware/upload.ts for an S3-compatible client.
UPLOAD_DIR=uploads
PUBLIC_UPLOAD_PATH=/uploads

# First Admin account created by `npm run seed`
SEED_ADMIN_EMAIL=admin@aircairo.com
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_ADMIN_NAME=System Administrator

# Mailer (src/lib/mailer.ts currently logs to the console — wire up a real
# provider such as SMTP/SES/Resend here before going to production)
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="AXIS Aviation Solutions <no-reply@aircairo.com>"
